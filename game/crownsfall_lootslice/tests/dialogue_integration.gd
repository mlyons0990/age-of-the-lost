extends "res://tests/inventory_ui_integration.gd"
const Dialogue := preload("res://scripts/dialogue_controller.gd")

func shot(name: String) -> void:
	if DisplayServer.get_name() == "headless": return
	await frames(3); await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://previews/dialogue/"+name+".png")

func _run() -> void:
	change_scene_to_file("res://main.tscn"); await frames(5)
	main = current_scene; p = main.player; trial = main.encounter; ui = main.hud
	main.sound.set_muted(true); main.set_process(false); p.set_physics_process(false); trial.set_process(false)
	reset_actor("", "mage", 40)
	var d: Node = main.dialogue; d.set_process(false)
	d.set_voice_enabled(true); d.set_voice_volume(0.7); d.set_subtitles(true)
	DirAccess.make_dir_recursive_absolute("res://previews/dialogue")
	check(d.lines.size() == 3, "only the selected quartermaster and Cantor pilot lines are installed")
	for id in d.lines:
		var stream: AudioStream = load(d.lines[id].audio)
		check(stream != null and stream.get_length() > 0 and stream.get_length() < 15, id+" imports as bounded real audio")
	check(not d.play_line("unknown") and d.active.is_empty(), "unknown dialogue is safely rejected")
	ui.open_page("merchant")
	check(paused and d.active.id == "quartermaster_greeting", "opening actual quartermaster starts its selected greeting while the world is paused")
	check(d.voice.playing and d.panel.visible and d.caption.text.contains("Quartermaster:"), "voice and attributed subtitle start together")
	check(main.sound.muted, "dialogue does not change the independent sound-effect setting")
	var left: float = d.remaining; d.advance(0.1)
	check(d.remaining < left and not d.voice.stream_paused, "merchant conversation advances inside the paused service screen")
	check(d.panel.mouse_filter == Control.MOUSE_FILTER_IGNORE and d.caption.mouse_filter == Control.MOUSE_FILTER_IGNORE, "subtitle overlay cannot intercept inventory clicks")
	await shot("quartermaster_subtitle")
	check(d.panel.get_global_rect().encloses(d.caption.get_global_rect()), "the full caption rectangle stays inside its background from the first frame")
	check(d.panel.size.y <= 100 and d.caption.get_line_count() <= 2, "merchant subtitle starts at readable two-line height rather than an oversized layout")
	check(d.panel.position.x+d.panel.size.x < ui.inventory_shell.dock.position.x, "merchant subtitle clears the inventory panel")
	ui.close_page()
	check(d.active.is_empty() and not d.voice.playing and not d.panel.visible, "leaving service immediately cancels voice and subtitle")
	ui.open_page("merchant")
	check(d.active.is_empty(), "reopening the vendor during cooldown does not repeat the greeting")
	ui.close_page(); d.advance(31); ui.open_page("merchant")
	check(d.active.get("id") == "quartermaster_greeting", "greeting becomes eligible again after its cooldown")
	d.set_voice_enabled(false)
	check(not d.voice.playing and d.panel.visible, "voice mute immediately stops sound without losing subtitles")
	d.set_subtitles(false)
	check(not d.panel.visible, "subtitle preference immediately hides the caption")
	d.set_subtitles(true); d.set_voice_enabled(true); ui.close_page()
	check(trial.start(), "actual Cantor encounter starts")
	freeze_enemies()
	check(d.active.get("id") == "cantor_challenge", "encounter entry triggers the selected enemy line")
	left = d.remaining; ui.open_page("pause"); d.advance(0.5)
	check(d.remaining == left and d.voice.stream_paused and not d.panel.visible, "pause menu suspends enemy voice and subtitle together")
	ui.close_page(); d.advance(0.1)
	check(d.remaining < left and not d.voice.stream_paused and d.panel.visible, "resume restores the same line without replaying it")
	trial.boss.hp = trial.boss.max_hp * 0.5; trial.advance(0.01); freeze_enemies()
	check(d.active.get("id") == "cantor_second_verse", "real half-health transition interrupts with the higher-priority second verse")
	d.last_played.erase("cantor_challenge")
	check(not d.play_line("cantor_challenge") and d.active.id == "cantor_second_verse", "lower-priority/repeated lines cannot interrupt the current verse")
	await shot("cantor_second_verse")
	trial.finish(false,"Dialogue QA",false)
	check(d.active.is_empty() and not d.voice.playing, "retreat cancels encounter dialogue without leaving queued speech")
	d.last_played.clear(); d.set_voice_enabled(false)
	check(trial.start() and not d.voice.playing and d.panel.visible, "muted encounter retains readable subtitles and unchanged gameplay")
	freeze_enemies(); p.hp = 1; p.invuln = 0; p.hurt(99999,40)
	check(d.active.is_empty() and not d.panel.visible, "player death cancels the selected voice immediately")
	check(not d.play_line("cantor_challenge"), "dead player cannot start a stale conversation")
	reset_actor("", "mage", 40); d.last_played.clear(); d.set_voice_enabled(true)
	var original: String = d.lines.quartermaster_greeting.audio
	d.lines.quartermaster_greeting.audio = "res://assets/audio/dialogue/missing.mp3"
	ui.open_page("merchant")
	check(d.panel.visible and not d.voice.playing, "missing recording falls back to the same subtitle without an engine error")
	d.lines.quartermaster_greeting.audio = original
	d.advance(20)
	check(d.active.is_empty() and not d.panel.visible, "finished line clears subtitle and playback resource")
	ui.close_page(); main.save_game(); var saved := FileAccess.get_sha256(main.SAVE_PATH)
	ui.open_page("pause")
	var slider: HSlider = ui.char_panel.find_child("VoiceVolume",true,false)
	check(slider != null, "pause menu exposes a separate voice-volume slider")
	slider.value = 35
	check(is_equal_approx(d.voice_volume,0.35), "actual slider updates voice level")
	button(ui.char_panel,"Dialogue voices: On").pressed.emit()
	check(not d.voice_enabled and button(ui.char_panel,"Dialogue voices: Off") != null, "actual voice toggle rebuilds pause controls correctly")
	button(ui.char_panel,"Dialogue subtitles: On").pressed.emit()
	check(not d.subtitles_enabled, "actual subtitle toggle changes the preference")
	check(FileAccess.get_sha256(main.SAVE_PATH) == saved, "dialogue preferences never rewrite character progression")
	await shot("dialogue_settings")
	var restored := Dialogue.new(); restored.main = main; root.add_child(restored); restored.set_process(false)
	check(not restored.voice_enabled and not restored.subtitles_enabled and is_equal_approx(restored.voice_volume,0.35), "voice and subtitle preferences survive controller recreation")
	restored.queue_free(); await frames()
	d.set_voice_volume(-1); check(d.voice_volume == 0, "negative voice volume clamps to silence")
	d.set_voice_volume(5); check(d.voice_volume == 1, "excess voice volume clamps to one")
	d.set_voice_volume(NAN); check(d.voice_volume == 1, "non-finite volume is ignored")
	check(main._valid_save(main.capture_save()), "dialogue leaves schema-six saves valid")
	d.set_voice_enabled(true); d.set_subtitles(true); d.set_voice_volume(0.7); ui.close_page()
	var f := FileAccess.open("res://tests/DIALOGUE_LAST_RUN.txt",FileAccess.WRITE)
	f.store_string("\n".join(report)+"\nDIALOGUE RESULT %d checks; %d failures\n" % [checks,failures]); f.close()
	print("DIALOGUE RESULT %d checks; %d failures" % [checks,failures])
	await main.quit_game(1 if failures else 0)
